# Copy this file to backend/.env and fill in your own values.
# Never commit backend/.env.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
PORT=5001

# Use a long random string, e.g. the output of: openssl rand -hex 32
JWT_SECRET=

NODE_ENV=development

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI assistant (Claude). Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5
AI_MODEL=
# Optional limits on messages to the AI assistant (defaults: 5, 40, 200).
# Per user per minute, per user per 24 hours, and all users together per 24 hours.
AI_LIMIT_PER_MINUTE=
AI_LIMIT_PER_DAY=
AI_LIMIT_TOTAL_PER_DAY=
